{
  "name": "clone-tabnews-v2",
  "version": "1.0.0",
  "description": "Implementação do tabnews.com.br para curso.dev - versão 2",
  "homepage": "https://github.com/diegovitall/clone-tabnews-v2#readme",
  "bugs": {
    "url": "https://github.com/diegovitall/clone-tabnews-v2/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diegovitall/clone-tabnews-v2.git"
  },
  "license": "MIT",
  "author": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "npm run services:up && next dev",
    "services:up": "docker compose -f infra/compose.yaml up -d",
    "services:stop": "docker compose -f infra/compose.yaml stop",
    "services:down": "docker compose -f infra/compose.yaml down",
    "lint:check": "prettier --check .",
    "lint:fix": "prettier --write .",
    "test": "jest",
    "test:watch": "jest --watchAll --runInBand --verbose",
    "migration:create": "node-pg-migrate --migrations-dir infra/migrations create",
    "migration:up": "node-pg-migrate -m infra/migrations --envPath .env.development up"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "next": "^16.2.6",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.22.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "prettier": "^3.8.3"
  }
}
